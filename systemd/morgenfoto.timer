[Unit]
Description=Täglich um 23:59 ein Foto vom Ölzähler

[Timer]
# 23:59 statt morgens: Das Foto hält den Stand am Tagesende fest, die
# Differenz zweier Fotos ist damit der Verbrauch genau eines Kalendertags.
# Der Dateiname wird beim Start des Skripts gebildet, ein Lauf über
# Mitternacht bekommt also trotzdem das Datum des gemessenen Tages.
OnCalendar=*-*-* 23:59:00
# Ohne diese Angabe darf systemd bis zu einer Minute später starten.
AccuracySec=1s
# Bewusst kein Persistent=true: War der Pi um 23:59 aus, wird das Foto
# nicht beim nächsten Hochfahren zu einer beliebigen Uhrzeit nachgeholt.

[Install]
WantedBy=timers.target
